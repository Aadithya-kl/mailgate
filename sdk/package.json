{
  "name": "@mailgate/sdk",
  "version": "1.0.0",
  "description": "Zero-dependency JavaScript/TypeScript client SDK for MailGate — waitForOtp() and waitForEmail() for Playwright, Cypress, and CI/CD E2E tests.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Dicka18/mailgate/tree/main/sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dicka18/mailgate.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/Dicka18/mailgate/issues"
  },
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "keywords": [
    "mailgate",
    "otp",
    "e2e",
    "playwright",
    "cypress",
    "email-testing",
