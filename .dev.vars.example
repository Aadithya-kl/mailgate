# Copy this file to .dev.vars for local development (`npm run dev`).
# For production, set these using Wrangler secrets:
#   npx wrangler secret put ADMIN_EMAIL
#   npx wrangler secret put ADMIN_TOKEN
#   npx wrangler secret put SESSION_SECRET

ADMIN_EMAIL=admin@example.com
ADMIN_TOKEN=replace-with-a-strong-admin-token
SESSION_SECRET=replace-with-a-random-32-byte-secret-string
